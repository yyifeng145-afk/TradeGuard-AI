PORT=8787
# PostgreSQL and Redis are mandatory runtime dependencies. SQLite is only accepted by the offline migration command.
DATABASE_URL=postgresql://crm_app:change-me@127.0.0.1:5432/tradeguard
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
REDIS_CONNECT_TIMEOUT_MS=5000
# Production only: APP_ENV=production and a public HTTPS URL.
APP_ENV=development
CRM_PUBLIC_URL=
CRM_BACKUP_DIR=
# Exact IP/CIDR of the trusted reverse proxy as seen by the API container, comma-separated.
CRM_TRUSTED_PROXY_CIDRS=
# Optional: an OpenAI-compatible /chat/completions endpoint.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=30000
# Used only for metadata cost accounting (USD per one million tokens).
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Optional enterprise knowledge search.
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_KNOWLEDGE_BASE_MAP={"org_northstar":"your-knowledge-base-id"}
# Optional metadata-only run traces. Customer text and tool arguments are excluded.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicit opt-in: confirmed customer preferences are sent to Mem0 Platform.
MEM0_SYNC_ENABLED=false
MEM0_API_KEY=
# Optional internal Feishu group notifications. Never send customer text or quote amounts to the group.
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
# Bearer token used only by Prometheus/Alertmanager internal endpoints. Production requires 32+ random characters.
CRM_METRICS_TOKEN=
# Any supported secret may alternatively be supplied through NAME_FILE=/run/secrets/name.
