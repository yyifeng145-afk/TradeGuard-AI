{
  "name": "borderless-crm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "mcp:stdio": "node --env-file-if-exists=.env --import tsx server/mcp.ts",
    "bootstrap:admin": "node --env-file-if-exists=.env --import tsx server/bootstrap-admin.ts",
    "backup": "node --env-file-if-exists=.env --import tsx server/backup.ts",
    "restore:drill": "node --import tsx scripts/restore-drill.ts",
    "verify:external": "node --env-file-if-exists=.env.production --import tsx scripts/verify-external.ts",
    "verify:security": "node --env-file-if-exists=.env.validation --import tsx scripts/security-check.ts",
    "test:load": "node --env-file-if-exists=.env.validation --import tsx scripts/load-test.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
